<style>
:root {
  --bg: #070709;
  --surface: #0f0f14;
  --surface-glass: rgba(18, 18, 24, 0.7);
  --border: rgba(255, 255, 255, 0.08);
  --border-glow: rgba(240, 61, 120, 0.35);
  --accent-pink: #ff2d78;
  --accent-gold: #f9cb42;
  --accent-cyan: #00f2fe;
  --text-main: #f5f5f7;
  --text-muted: #8e8d9a;
  --font-serif: "Cormorant Garamond", serif;
  --font-sans: "Plus Jakarta Sans", sans-serif;
  --font-mono: "Space Grotesk", monospace;
  --ease-cinematic: cubic-bezier(0.16, 1, 0.3, 1);
}

* { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; background: var(--bg); color: var(--text-main); font-family: var(--font-sans); overflow-x: hidden; }
body { position: relative; min-height: 100vh; overflow-x: hidden; }

/* Custom Futuristic Cursor */
.cursor-dot, .cursor-circle {
  pointer-events: none;
  position: fixed;
  top: 0; left: 0;
  border-radius: 50%;
  z-index: 99999;
  transform: translate(-50%, -50%);
  transition: opacity 0.3s;
}
.cursor-dot { width: 6px; height: 6px; background: var(--accent-pink); }
.cursor-circle {
  width: 34px; height: 34px;
  border: 1px solid rgba(255, 45, 120, 0.5);
  transition: width 0.3s, height 0.3s, background-color 0.3s, border-color 0.3s;
}
.cursor-hover .cursor-circle {
  width: 55px; height: 55px;
  background: rgba(255, 45, 120, 0.12);
  border-color: var(--accent-gold);
}

/* Background Interactive Canvas */
#spaceCanvas {
  position: fixed;
  top: 0; left: 0;
  width: 100vw; height: 100vh;
  z-index: 0;
  pointer-events: none;
}

/* Scroll Progress Bar */
.scroll-progress {
  position: fixed;
  top: 0; left: 0;
  height: 2px;
  background: linear-gradient(90deg, var(--accent-pink), var(--accent-gold), var(--accent-cyan));
  z-index: 10001;
  width: 0%;
}

/* Header & Glass Navigation */
header {
  height: 80px;
  position: fixed;
  top: 0; left: 0; right: 0;
  padding: 0 6vw;
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 1000;
  transition: background 0.4s, backdrop-filter 0.4s, border 0.4s;
}
header.scrolled {
  background: var(--surface-glass);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  border-bottom: 1px solid var(--border);
}
.logo {
  font-family: var(--font-serif);
  font-size: 26px;
  font-weight: 700;
  letter-spacing: 4px;
  color: var(--text-main);
  text-decoration: none;
  display: flex;
  align-items: center;
  gap: 8px;
}
.logo span { color: var(--accent-pink); font-size: 14px; animation: pulseGlow 2s infinite alternate; }
.logo b { color: var(--accent-pink); }
@keyframes pulseGlow {
  0% { transform: scale(0.9); opacity: 0.6; filter: drop-shadow(0 0 2px var(--accent-pink)); }
  100% { transform: scale(1.2); opacity: 1; filter: drop-shadow(0 0 10px var(--accent-pink)); }
}

nav { display: flex; gap: 32px; font-family: var(--font-mono); font-size: 11px; letter-spacing: 2px; }
nav a { color: var(--text-muted); text-decoration: none; position: relative; transition: color 0.3s; }
nav a::after {
  content: ''; position: absolute; bottom: -4px; left: 0; width: 0; height: 1px;
  background: var(--accent-pink); transition: width 0.3s var(--ease-cinematic);
}
nav a:hover { color: #fff; }
nav a:hover::after { width: 100%; }

.btn-book {
  position: relative;
  overflow: hidden;
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: 2px;
  color: #fff;
  text-decoration: none;
  padding: 10px 22px;
  background: transparent;
  border: 1px solid var(--border);
  border-radius: 40px;
  backdrop-filter: blur(5px);
  transition: border-color 0.4s, transform 0.3s;
}
.btn-book::before {
  content: ''; position: absolute; inset: 0;
  background: linear-gradient(120deg, transparent, rgba(255, 45, 120, 0.4), transparent);
  transform: translateX(-100%);
  transition: transform 0.6s var(--ease-cinematic);
}
.btn-book:hover { border-color: var(--accent-pink); transform: translateY(-2px); }
.btn-book:hover::before { transform: translateX(100%); }

/* Layout Containers */
main { position: relative; z-index: 1; }
section { position: relative; }

/* Hero Section */
.hero {
  min-height: 100vh;
  padding: 120px 6vw 60px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: 4vw;
}
.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: 3px;
  color: var(--accent-gold);
  text-transform: uppercase;
  margin-bottom: 24px;
}
.eyebrow::before {
  content: ""; width: 8px; height: 8px; border-radius: 50%;
  background: var(--accent-gold); box-shadow: 0 0 10px var(--accent-gold);
}
h1.hero-title {
  font-family: var(--font-serif);
  font-size: clamp(54px, 7.5vw, 110px);
  line-height: 0.9;
  font-weight: 500;
  letter-spacing: -2px;
  margin-bottom: 25px;
}
.hero-title .gradient-text {
  background: linear-gradient(135deg, #fff 20%, var(--accent-pink) 80%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}
.hero-copy p {
  max-width: 440px;
  color: var(--text-muted);
  font-size: 15px;
  line-height: 1.7;
  font-weight: 300;
  margin-bottom: 35px;
}
.hero-cta {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  font-family: var(--font-mono);
  font-size: 12px;
  letter-spacing: 2px;
  color: var(--text-main);
  text-decoration: none;
  position: relative;
  padding-bottom: 6px;
}
.hero-cta::after {
  content: ""; position: absolute; bottom: 0; left: 0; width: 100%; height: 1px;
  background: linear-gradient(90deg, var(--accent-pink), transparent);
}
.hero-cta span { transition: transform 0.3s; }
.hero-cta:hover span { transform: translateX(6px); color: var(--accent-pink); }

.hero-photo-wrap {
  position: relative;
  height: 72vh;
  perspective: 1000px;
}
.hero-card-3d {
  width: 100%; height: 100%;
  position: relative;
  border-radius: 16px;
  overflow: hidden;
  border: 1px solid var(--border);
  box-shadow: 0 30px 60px rgba(0,0,0,0.6);
  transform-style: preserve-3d;
  transition: transform 0.2s ease-out;
}
.hero-card-3d img {
  width: 100%; height: 100%;
  object-fit: cover;
  filter: brightness(0.92) contrast(1.05);
}
.hero-card-3d::after {
  content: ""; position: absolute; inset: 0;
  background: linear-gradient(180deg, transparent 60%, rgba(7,7,9,0.85));
}

/* Common Section Headers */
.section-header { margin-bottom: 45px; }
.section-title {
  font-family: var(--font-serif);
  font-size: clamp(40px, 5.5vw, 75px);
  font-weight: 500;
  line-height: 0.95;
  letter-spacing: -1px;
}
.section-title span { color: var(--accent-pink); font-style: italic; }

/* Categories Grid */
.categories { padding: 90px 6vw; }
.category-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}
.cat {
  position: relative;
  height: 420px;
  border-radius: 12px;
  overflow: hidden;
  text-decoration: none;
  border: 1px solid var(--border);
  background: var(--surface);
  transform-style: preserve-3d;
  transition: transform 0.4s var(--ease-cinematic), border-color 0.4s, box-shadow 0.4s;
}
.cat img {
  width: 100%; height: 100%;
  object-fit: cover;
  transition: transform 0.8s var(--ease-cinematic), filter 0.8s;
  filter: grayscale(20%);
}
.cat::after {
  content: ""; position: absolute; inset: 0;
  background: linear-gradient(0deg, rgba(7, 7, 9, 0.9) 0%, rgba(7, 7, 9, 0.2) 60%, transparent 100%);
  transition: opacity 0.4s;
}
.cat-content {
  position: absolute;
  bottom: 24px; left: 24px; right: 24px;
  z-index: 2;
  transform: translateZ(30px);
}
.cat-content small {
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: 3px;
  color: var(--accent-gold);
  display: block;
  margin-bottom: 6px;
}
.cat-content h3 {
  font-family: var(--font-serif);
  font-size: 32px;
  color: #fff;
  font-weight: 500;
  letter-spacing: 1px;
  transition: transform 0.3s;
}
.cat:hover {
  border-color: var(--border-glow);
  box-shadow: 0 15px 35px rgba(240, 61, 120, 0.2);
}
.cat:hover img { transform: scale(1.08); filter: grayscale(0%); }
.cat:hover .cat-content h3 { transform: translateX(6px); color: var(--accent-pink); }

/* Dynamic Gallery Grid */
.photos { padding: 90px 6vw; border-top: 1px solid var(--border); }
.photo-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  grid-auto-rows: 240px;
  gap: 16px;
}
.photo-item {
  position: relative;
  border-radius: 8px;
  overflow: hidden;
  border: 1px solid var(--border);
  background: var(--surface);
  transition: transform 0.5s var(--ease-cinematic), border-color 0.5s, box-shadow 0.5s;
}
.photo-item:nth-child(1),
.photo-item:nth-child(6),
.photo-item:nth-child(9),
.photo-item:nth-child(14) { grid-row: span 2; }
.photo-item img {
  width: 100%; height: 100%;
  object-fit: cover;
  transition: transform 0.7s var(--ease-cinematic), filter 0.5s;
}
.photo-item::before {
  content: ""; position: absolute; inset: 0;
  background: rgba(7,7,9,0.3);
  z-index: 1;
  transition: opacity 0.4s;
}
.photo-item:hover {
  border-color: var(--accent-gold);
  box-shadow: 0 10px 30px rgba(0,0,0,0.8);
  transform: translateY(-4px);
  z-index: 2;
}
.photo-item:hover img { transform: scale(1.06); }
.photo-item:hover::before { opacity: 0; }

/* Video Slider Section */
.video-section {
  padding: 100px 6vw;
  border-top: 1px solid var(--border);
  overflow: hidden;
}
.video-section.alt-glow {
  background: radial-gradient(circle at 80% 20%, rgba(255, 45, 120, 0.08) 0%, transparent 50%);
}
.video-head-flex {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 40px;
}
.video-head-flex p { max-width: 320px; color: var(--text-muted); font-size: 14px; font-weight: 300; }

.slider-window { overflow: hidden; position: relative; border-radius: 12px; }
.slider-track { display: flex; gap: 20px; transition: transform 0.8s var(--ease-cinematic); }
.video-card {
  flex: 0 0 calc((100% - 40px) / 3);
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 12px;
  overflow: hidden;
  padding: 12px;
  box-shadow: 0 20px 40px rgba(0,0,0,0.4);
  transition: transform 0.4s, border-color 0.4s;
}
.video-card:hover { border-color: var(--accent-pink); transform: translateY(-4px); }
.video-card iframe {
  width: 100%;
  aspect-ratio: 16/9;
  border: 0;
  border-radius: 8px;
  display: block;
}
.card-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 6px 4px;
}
.card-meta strong { font-family: var(--font-serif); font-size: 18px; font-weight: 500; color: #fff; }
.card-meta span { font-family: var(--font-mono); font-size: 10px; letter-spacing: 2px; color: var(--accent-gold); }

.slider-dots { display: flex; justify-content: center; gap: 8px; margin-top: 30px; }
.slider-dots .dot {
  height: 3px; width: 24px;
  background: rgba(255, 255, 255, 0.15);
  border: none;
  cursor: pointer;
  border-radius: 4px;
  transition: width 0.4s var(--ease-cinematic), background-color 0.4s;
}
.slider-dots .dot.active { width: 45px; background: var(--accent-pink); }

/* Interactive Contact Section */
.contact {
  padding: 130px 6vw;
  text-align: center;
  border-top: 1px solid var(--border);
  background: radial-gradient(circle at 50% 50%, rgba(249, 203, 66, 0.06) 0%, transparent 60%);
  position: relative;
}
.contact-bg-watermark {
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  font-family: var(--font-serif);
  font-size: 22vw;
  font-weight: 700;
  color: rgba(255,255,255,0.015);
  user-select: none;
  pointer-events: none;
  white-space: nowrap;
}
.contact h2 {
  font-family: var(--font-serif);
  font-size: clamp(48px, 7vw, 90px);
  line-height: 1;
  margin-bottom: 20px;
}
.contact p {
  font-family: var(--font-mono);
  font-size: 13px;
  letter-spacing: 3px;
  color: var(--text-muted);
  text-transform: uppercase;
  margin-bottom: 40px;
}
.contact .btn-main {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  font-family: var(--font-mono);
  font-size: 13px;
  letter-spacing: 2px;
  color: #070709;
  background: #fff;
  padding: 18px 36px;
  border-radius: 50px;
  text-decoration: none;
  font-weight: 600;
  position: relative;
  overflow: hidden;
  transition: transform 0.3s, box-shadow 0.3s, background 0.3s;
}
.contact .btn-main:hover {
  background: var(--accent-pink);
  color: #fff;
  transform: scale(1.04);
  box-shadow: 0 10px 40px rgba(255, 45, 120, 0.4);
}

/* Social Connect */
.social-bottom { padding: 50px 6vw; border-top: 1px solid var(--border); background: var(--surface); }
.social-flex { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 20px; }
.social-handles { display: flex; gap: 15px; }
.social-link {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 20px;
  background: rgba(255,255,255,0.02);
  border: 1px solid var(--border);
  border-radius: 8px;
  color: var(--text-main);
  text-decoration: none;
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: 1.5px;
  transition: border-color 0.3s, background 0.3s, transform 0.3s;
}
.social-link:hover {
  border-color: var(--accent-gold);
  background: rgba(249, 203, 66, 0.08);
  transform: translateY(-3px);
}

/* Footer */
footer {
  padding: 25px 6vw;
  border-top: 1px solid var(--border);
  display: flex;
  justify-content: space-between;
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: 2px;
  color: var(--text-muted);
}

/* Cinematic Reveal on Scroll */
.reveal-on-scroll {
  opacity: 0;
  transform: translateY(40px);
  transition: opacity 1s var(--ease-cinematic), transform 1s var(--ease-cinematic);
}
.reveal-on-scroll.is-visible {
  opacity: 1;
  transform: translateY(0);
}

/* Responsive Rules */
@media (max-width: 992px) {
  .hero { grid-template-columns: 1fr; padding-top: 120px; }
  .hero-photo-wrap { height: 50vh; order: -1; }
  .category-grid { grid-template-columns: repeat(2, 1fr); }
  .photo-grid { grid-template-columns: repeat(2, 1fr); }
  .video-card { flex: 0 0 85vw; }
  nav, .btn-book { display: none; }
  .cursor-dot, .cursor-circle { display: none; }
}
@media (max-width: 580px) {
  .category-grid { grid-template-columns: 1fr; }
  .photo-grid { grid-template-columns: 1fr; }
  .social-flex { flex-direction: column; align-items: flex-start; }
}
</style>
</head>
