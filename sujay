/* =========================================================
   6. YOUTUBE SLIDERS SETUP
   ========================================================= */
const fullnessOfLove = [
  "YOUR_LOVE_VIDEO_ID_01","YOUR_LOVE_VIDEO_ID_02","YOUR_LOVE_VIDEO_ID_03",
  "YOUR_LOVE_VIDEO_ID_04","YOUR_LOVE_VIDEO_ID_05","YOUR_LOVE_VIDEO_ID_06",
  "YOUR_LOVE_VIDEO_ID_07","YOUR_LOVE_VIDEO_ID_08","YOUR_LOVE_VIDEO_ID_09",
  "YOUR_LOVE_VIDEO_ID_10"
];

const clientReviews = [
  "YOUR_REVIEW_VIDEO_ID_01","YOUR_REVIEW_VIDEO_ID_02","YOUR_REVIEW_VIDEO_ID_03",
  "YOUR_REVIEW_VIDEO_ID_04","YOUR_REVIEW_VIDEO_ID_05","YOUR_REVIEW_VIDEO_ID_06",
  "YOUR_REVIEW_VIDEO_ID_07","YOUR_REVIEW_VIDEO_ID_08","YOUR_REVIEW_VIDEO_ID_09",
  "YOUR_REVIEW_VIDEO_ID_10"
];

function initSlider(trackId, dotId, videoIds, label) {
  const track = document.getElementById(trackId);
  const dots = document.getElementById(dotId);
  if(!track || !dots) return;

  let currentIndex = 0;
  track.innerHTML = "";
  dots.innerHTML = "";

  videoIds.forEach((id, idx) => {
    const card = document.createElement("div");
    card.className = "video-card";
    const valid = id && !id.startsWith("YOUR_");
    const src = valid ? `https://www.youtube.com/embed/${id}?enablejsapi=1&rel=0` : "about:blank";

    card.innerHTML = `
      <iframe src="${src}" title="${label} ${idx+1}" allow="autoplay; encrypted-media" allowfullscreen></iframe>
      <div class="card-meta">
        <strong>${label} ${String(idx+1).padStart(2, '0')}</strong>
        <span>CINEMA // ${String(idx+1).padStart(2, '0')}</span>
      </div>`;
    track.appendChild(card);

    const dotBtn = document.createElement("button");
    dotBtn.className = "dot" + (idx === 0 ? " active" : "");
    dotBtn.onclick = () => goToSlide(idx);
    dots.appendChild(dotBtn);
  });

  function getVisibleCount() { return window.innerWidth <= 992 ? 1 : 3; }

  function goToSlide(idx) {
    const max = Math.max(0, videoIds.length - getVisibleCount());
    currentIndex = Math.max(0, Math.min(idx, max));
    const firstCard = track.children[0];
    if (firstCard) {
      const cardWidth = firstCard.getBoundingClientRect().width + 20;
      track.style.transform = `translateX(${-currentIndex * cardWidth}px)`;
    }
    [...dots.children].forEach((d, i) => d.classList.toggle("active", i === currentIndex));
  }
}

initSlider("loveTrack", "loveDots", fullnessOfLove, "Sequence");
initSlider("reviewTrack", "reviewDots", clientReviews, "Review");

/* =========================================================
   7. INTERSECTION OBSERVER (CINEMATIC SCROLL REVEAL)
   ========================================================= */
const scrollElements = document.querySelectorAll(".reveal-on-scroll");
const observer = new IntersectionObserver((entries, obs) => {
  entries.forEach(entry => {
    if (entry.isIntersecting) {
      entry.target.classList.add("is-visible");
      obs.unobserve(entry.target);
    }
  });
}, { threshold: 0.12 });

scrollElements.forEach(el => observer.observe(el));
</script>
